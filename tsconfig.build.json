{
  // Publishing config only. Development runs the TypeScript directly
  // (`node src/main.ts`), but Node refuses to strip types for anything under
  // node_modules, so an installed package has to ship real JavaScript.
  // `rewriteRelativeImportExtensions` turns the `./foo.ts` specifiers the
  // source uses into `./foo.js` in the emitted output.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src"]
}
